#!/usr/bin/env bash
# Checks that turned PRs red after the push most often (review-rate, 23/11):
# commit messages, CHANGELOG lines and placement, licenses after a
# Cargo.lock change. Each takes seconds. Install once: `make hooks`.
# Skip one push: `git push --no-verify`.
set -uo pipefail
base="$(git merge-base origin/main HEAD 2>/dev/null)" || exit 0
fail=0
run() { "$@" || { echo "pre-push: failed: $*" >&2; fail=1; }; }
run scripts/commitlint.sh "$base" HEAD
run scripts/changelog-lint.sh
run scripts/changelog-placement.sh "$base" HEAD
if ! git diff --quiet "$base" HEAD -- Cargo.lock; then run scripts/licenses.py check; fi
exit "$fail"
