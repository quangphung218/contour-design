#!/bin/sh
# QA mock `claude` (qa/lib.mjs puts this folder before ../../mock-agent on
# the daemon's PATH). Requests of its own, everything else goes to the
# shared mock unchanged:
# - `qa-crash`: prints to stderr and exits 3 without a result line.
# - `qa-jury-slow`: a Design Jury that closes round 1, then thinks until
#   it is interrupted.
# - `qa-linger`: streams for 6 s ignoring a closed pipe, as Node does,
#   then writes linger.html.
shared="$(cd "$(dirname "$0")/../../mock-agent" && pwd)/claude"
case "$1" in --version) exec "$shared" "$@";; esac
if [ "$1" = "-p" ] && [ "$2" = "--help" ]; then exec "$shared" "$@"; fi

sid=""; prev=""
for a in "$@"; do
  case "$prev" in --session-id|--resume) sid="$a";; esac
  prev="$a"
done
IFS= read -r line

# Only the new request counts: the prompt also carries the earlier turns.
req=$(printf '%s' "$line" | sed -e 's/.*# User request\\n\\n//' -e 's/\([^\\]\)".*/\1/')
case "$req" in *qa-crash*)
  printf '{"type":"system","subtype":"init","session_id":"%s","model":"mock-1"}\n' "$sid"
  echo "mock: model overloaded, try again later" >&2
  exit 3
;; esac

case "$req" in *qa-linger*)
  # Like a real CLI (Node ignores EPIPE): keeps working when the daemon is
  # gone, then writes linger.html.
  trap '' PIPE
  printf '{"type":"system","subtype":"init","session_id":"%s","model":"mock-1"}\n' "$sid"
  printf '{"type":"assistant","message":{"id":"qa-l1","role":"assistant","content":[{"type":"text","text":"Lingering. "}]}}\n'
  i=0
  while [ $i -lt 30 ]; do sleep 0.2; printf '{"type":"assistant","message":{"id":"qa-l%s","role":"assistant","content":[{"type":"text","text":"."}]}}\n' "$i" 2>/dev/null; i=$((i + 1)); done
  printf '<h1>written after six seconds</h1>' > linger.html
  printf '{"type":"result","subtype":"success","is_error":false,"stop_reason":"end_turn"}\n' 2>/dev/null
  exit 0
;; esac

case "$req" in *qa-jury-slow*)
  # A Design Jury that closes round 1 and then thinks until interrupted.
  printf '{"type":"system","subtype":"init","session_id":"%s","model":"mock-1"}\n' "$sid"
  printf '%s\n' '{"type":"assistant","message":{"id":"qa-j1","role":"assistant","content":[{"type":"text","text":"<CRITIQUE_RUN version=\"1\" maxRounds=\"3\" threshold=\"8.0\" scale=\"10\"><ROUND n=\"1\"><PANELIST role=\"designer\"><NOTES>Draft.</NOTES><ARTIFACT><![CDATA[<h1 id=\"title\">Jury round one</h1>]]></ARTIFACT></PANELIST><PANELIST role=\"critic\" score=\"6\" must_fix=\"1\"><MUST_FIX>More contrast.</MUST_FIX></PANELIST><PANELIST role=\"brand\" score=\"7\"></PANELIST><PANELIST role=\"a11y\" score=\"6\"></PANELIST><PANELIST role=\"copy\" score=\"7\"></PANELIST><ROUND_END n=\"1\" decision=\"continue\"></ROUND_END></ROUND><ROUND n=\"2\"><PANELIST role=\"designer\"><NOTES>Trying again.</NOTES></PANELIST>"}]}}'
  sleep 60
  exit 0
;; esac

# Turn files written with shell commands (no Write tool), as ffmpeg,
# python or cp do. `qa-sh <word>` picks the shape:
# - `frames-N`: N PNG frames in frames/ plus frames/film.mp4
# - `kinds`: 11 PNG and 10 JPG in shots/ (no kind past 20)
# - `rows-N`: one file in each of N folders (d01/f.txt …)
# - `edit`: appends to notes.txt (made earlier by the test)
# - `name`: "báo cáo 🍜.txt" at the root
# - `page`: index.html, as `python gen.py > index.html` would
# - `late-<file>-<s>`: sleeps <s> seconds, then writes <file>
# - `early-<file>-<s>`: writes <file> at once, then sleeps <s> seconds
case "$req" in *qa-sh\ *)
  word=$(printf '%s' "$req" | sed -e 's/.*qa-sh \([^ \\]*\).*/\1/')
  printf '{"type":"system","subtype":"init","session_id":"%s","model":"mock-1"}\n' "$sid"
  printf '{"type":"assistant","message":{"id":"qa-sh-%s","role":"assistant","content":[{"type":"tool_use","id":"sh-%s","name":"Bash","input":{"command":"qa-sh %s"}}]}}\n' "$$" "$$" "$word"
  case "$word" in
  frames-*)
    n=${word#frames-}; mkdir -p frames; i=1
    while [ "$i" -le "$n" ]; do printf 'png%s' "$i" > "frames/f$(printf '%04d' "$i").png"; i=$((i + 1)); done
    printf 'mp4' > frames/film.mp4
    ;;
  kinds)
    mkdir -p shots; i=1
    while [ "$i" -le 11 ]; do printf 'p' > "shots/s$i.png"; i=$((i + 1)); done
    i=1
    while [ "$i" -le 10 ]; do printf 'j' > "shots/s$i.jpg"; i=$((i + 1)); done
    ;;
  rows-*)
    n=${word#rows-}; i=1
    while [ "$i" -le "$n" ]; do d=$(printf 'd%02d' "$i"); mkdir -p "$d"; printf 'row %s' "$i" > "$d/f.txt"; i=$((i + 1)); done
    ;;
  edit) printf '\nmore from the shell\n' >> notes.txt ;;
  name) printf 'xin chào' > 'báo cáo 🍜.txt' ;;
  page) printf '<!doctype html><html><body><h1 id="title">Shell page</h1></body></html>' > index.html ;;
  late-*)
    rest=${word#late-}; f=${rest%-*}; s=${rest##*-}
    sleep "$s"; printf 'late' > "$f"
    ;;
  early-*)
    rest=${word#early-}; f=${rest%-*}; s=${rest##*-}
    printf 'early' > "$f"; sleep "$s"
    ;;
  esac
  printf '{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"sh-%s","content":"ok"}]}}\n' "$$"
  printf '{"type":"assistant","message":{"id":"qa-sh-%s-t","role":"assistant","content":[{"type":"text","text":"Shell done: %s."}]}}\n' "$$" "$word"
  printf '{"type":"result","subtype":"success","is_error":false,"stop_reason":"end_turn"}\n'
  cat >/dev/null
  exit 0
;; esac

# Not ours: hand the line (and the rest of stdin) to the shared mock.
{ printf '%s\n' "$line"; cat; } | exec "$shared" "$@"
